# =========================================
# Konfigurasi Database (sesuaikan dengan MySQL Anda)
# =========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finance_app
DB_USERNAME=root
DB_PASSWORD=

# =========================================
# Konfigurasi ZAWA API (WhatsApp Gateway)
# =========================================
# Endpoint resmi ZAWA untuk kirim pesan
ZAWA_URL=https://api-zawa.azickri.com/message

# ID sesi WhatsApp (didapat dari dashboard ZAWA saat membuat sesi/device)
ZAWA_ID=isi_dengan_id_sesi_zawa

# Session ID dari sesi yang sama (didapat dari dashboard ZAWA)
ZAWA_SESSION_ID=isi_dengan_session_id_zawa

# Nomor WhatsApp tujuan penerima laporan, format internasional TANPA tanda +
# Contoh: 6281234567890
TARGET_PHONE_NUMBER=6281234567890

# Timezone agar jadwal jam 20:00 sesuai WIB
APP_TIMEZONE=Asia/Jakarta
